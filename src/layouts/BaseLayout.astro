---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../site';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  /** Path to a 1200x630 preview image. Defaults to the generated card for this page. */
  ogImage?: string;
  /** Extra JSON-LD for search engines, written as a script tag in the head. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.bio[0], ogImage, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url);
const image = new URL(ogImage ?? ogImagePath(Astro.url.pathname), site.url);
const imageAlt = title ? `${title}, ${site.name}` : `${site.name}, ${site.role}`;
const xHandle = `@${new URL(site.links.x).pathname.replace(/\//g, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f1ec" />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          var root = document.documentElement;
          root.setAttribute('data-theme', theme);
          root.style.colorScheme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0e0f12' : '#f3f1ec');
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var nodes = document.querySelectorAll('[data-reveal]');
        if (!nodes.length) return;

        var vh = window.innerHeight || document.documentElement.clientHeight;
        var pending = [];

        for (var i = 0; i < nodes.length; i++) {
          var node = nodes[i];
          if (node.getBoundingClientRect().top > vh * 0.88) {
            node.classList.add('is-pending');
            pending.push(node);
          } else {
            node.classList.add('reveal');
          }
        }

        if (!pending.length || !('IntersectionObserver' in window)) {
          for (var j = 0; j < pending.length; j++) pending[j].classList.add('reveal');
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.remove('is-pending');
              entry.target.classList.add('reveal');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -5% 0px' }
        );

        pending.forEach(function (node) {
          observer.observe(node);
        });
      })();
    </script>
  </body>
</html>
