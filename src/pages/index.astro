---
import { Image } from 'astro:assets';
import headshot from '../assets/michael.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../site';
---

<BaseLayout>
  <section class="intro">
    <Image
      src={headshot}
      alt={site.name}
      width={300}
      height={400}
      densities={[1, 2]}
      class="portrait"
      loading="eager"
      decoding="async"
    />
    <h1>{site.name}</h1>
    <div class="bio">
      {site.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <SocialLinks />
  </section>
</BaseLayout>
