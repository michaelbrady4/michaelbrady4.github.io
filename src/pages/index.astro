---
import { Image } from 'astro:assets';
import headshot from '../assets/michael.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../projects';
import { site } from '../site';
---

<BaseLayout>
  <section class="intro reveal">
    <div class="portrait-wrap">
      <Image
        src={headshot}
        alt={site.name}
        width={300}
        height={400}
        densities={[1, 2]}
        class="portrait"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="intro-copy">
      <h1>{site.name}</h1>
      <div class="bio">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <SocialLinks />
    </div>
  </section>
  <section class="project-preview" aria-labelledby="selected-projects">
    <div class="project-preview-head reveal">
      <h2 id="selected-projects">Selected projects</h2>
      <a href="/projects/">All projects</a>
    </div>
    <ul class="project-list">
      {
        projects.map((project) => (
          <li data-reveal>
            <ProjectCard project={project} heading="h3" />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
