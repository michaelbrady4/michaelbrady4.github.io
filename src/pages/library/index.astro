---
import StarRating from '../../components/StarRating.astro';
import bookmarks from '../../data/library/bookmarks.json';
import reading from '../../data/library/reading.json';
import watching from '../../data/library/watching.json';
import youtube from '../../data/library/youtube.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/dates';

interface YoutubeVideo {
  id: string;
  title: string;
  url: string;
  channel?: string;
  thumbnail?: string;
  addedAt?: string;
}

const videos = youtube.videos as YoutubeVideo[];
const xCount = bookmarks.folders.reduce((sum, folder) => sum + folder.items.length, 0);
const readingCount = reading.currentlyReading.length + reading.read.length;
const watchingCount = watching.films.length;

const tabs = [
  { id: 'x', label: 'From X', count: xCount, mark: 'x' },
  { id: 'reading', label: 'Reading', count: readingCount, mark: '' },
  { id: 'watching', label: 'Watching', count: watchingCount, mark: '' },
  { id: 'youtube', label: 'YouTube', count: videos.length, mark: '' },
];

function updated(value: string | undefined) {
  return value ? formatDate(new Date(value)) : '';
}

function watched(value: string) {
  return formatDate(new Date(`${value}T00:00:00Z`));
}

function added(value: string) {
  const date = value.length === 10 ? `${value}T00:00:00Z` : value;
  return formatDate(new Date(date));
}
---

<BaseLayout title="Library" description="Links from X, books, films, and videos from Michael Brady.">
  <div class="page library" id="library" data-tab="x">
    <script is:inline>
      (function () {
        var root = document.getElementById('library');
        if (!root) return;
        var hash = (location.hash || '').replace('#', '');
        if (hash === 'saved') hash = 'x';
        var known = hash === 'reading' || hash === 'watching' || hash === 'youtube' || hash === 'x';
        root.classList.add('is-tabbed');
        root.setAttribute('data-tab', known ? hash : 'x');
      })();
    </script>
    <header class="page-heading reveal">
      <h1 class="page-title">Library</h1>
      <p class="library-lede">Links, books, films, and videos I want to remember.</p>
    </header>
    <div class="library-tabs" role="tablist" aria-label="Library sections">
      {
        tabs.map((tab) => (
          <button
            type="button"
            class="library-tab"
            role="tab"
            id={`tab-${tab.id}`}
            data-tab-target={tab.id}
            aria-controls={`panel-${tab.id}`}
            aria-selected={tab.id === 'x' ? 'true' : 'false'}
            tabindex={tab.id === 'x' ? 0 : -1}
          >
            <span class="library-tab-label">
              {
                tab.mark === 'x' && (
                  <svg class="library-x" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path
                      d="M3.2 3.2 12.8 12.8M12.8 3.2 3.2 12.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                    />
                  </svg>
                )
              }
              {tab.label}
            </span>
            <span class="library-count">{tab.count}</span>
          </button>
        ))
      }
    </div>
    <script is:inline>
      (function () {
        var root = document.getElementById('library');
        if (!root) return;
        var tabs = [].slice.call(root.querySelectorAll('[data-tab-target]'));
        var order = tabs.map(function (tab) {
          return tab.getAttribute('data-tab-target');
        });

        function select(name, focus, updateHash) {
          if (name === 'saved') name = 'x';
          if (order.indexOf(name) === -1) name = 'x';
          root.setAttribute('data-tab', name);
          tabs.forEach(function (tab) {
            var on = tab.getAttribute('data-tab-target') === name;
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            tab.tabIndex = on ? 0 : -1;
            if (on && focus) tab.focus();
          });
          if (updateHash && location.hash !== '#' + name) {
            history.replaceState(null, '', '#' + name);
          }
        }

        tabs.forEach(function (tab, index) {
          tab.addEventListener('click', function () {
            select(tab.getAttribute('data-tab-target'), false, true);
          });
          tab.addEventListener('keydown', function (event) {
            var next = null;
            if (event.key === 'ArrowRight') next = order[(index + 1) % order.length];
            if (event.key === 'ArrowLeft') next = order[(index - 1 + order.length) % order.length];
            if (event.key === 'Home') next = order[0];
            if (event.key === 'End') next = order[order.length - 1];
            if (!next) return;
            event.preventDefault();
            select(next, true, true);
          });
        });

        window.addEventListener('hashchange', function () {
          select(location.hash.replace('#', ''), false, false);
        });

        select(root.getAttribute('data-tab') || 'x', false, false);
      })();
    </script>

    <section class="library-panel" id="panel-x" data-panel="x" role="tabpanel" aria-labelledby="tab-x">
      <h2 class="library-panel-title">From X</h2>
      {
        bookmarks.folders.length === 0 ? (
          <div class="library-empty">
            <svg class="library-empty-x" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                d="M3.2 3.2 12.8 12.8M12.8 3.2 3.2 12.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              />
            </svg>
            <h2>Nothing from X yet.</h2>
            <p>Bookmark folders will show up here, grouped by topic.</p>
          </div>
        ) : (
          bookmarks.folders.map((folder) => (
            <section class="library-group" aria-labelledby={`topic-${folder.id}`}>
              <div class="library-section-head">
                <h2 id={`topic-${folder.id}`}>{folder.name}</h2>
                <span>{folder.items.length}</span>
              </div>
              {folder.items.length === 0 ? (
                <p class="library-quiet">No links in this topic.</p>
              ) : (
                <ul class="library-list">
                  {folder.items.map((item) => (
                    <li data-reveal>
                      <a class="library-link" href={item.url} target="_blank" rel="noopener noreferrer">
                        <span class="library-domain">{item.domain}</span>
                        <span class="library-link-title">{item.title}</span>
                        {item.note && <span class="library-note">{item.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        )
      }
    </section>

    <section class="library-panel" id="panel-reading" data-panel="reading" role="tabpanel" aria-labelledby="tab-reading">
      <h2 class="library-panel-title">Reading</h2>
      {
        readingCount === 0 ? (
          <div class="library-empty">
            <h2>Nothing on the shelf yet.</h2>
            <p>
              Books from <a href={reading.profileUrl}>Goodreads</a> will show up here.
            </p>
          </div>
        ) : (
          <>
            <div class="library-section-head">
              <a href={reading.profileUrl} target="_blank" rel="noopener noreferrer">
                Goodreads profile
              </a>
              {reading.fetchedAt && <time datetime={reading.fetchedAt}>Updated {updated(reading.fetchedAt)}</time>}
            </div>
            {
              reading.currentlyReading.length > 0 && (
                <>
                  <h2 class="library-kicker">Currently reading</h2>
                  <ul class="library-list">
                    {reading.currentlyReading.map((book) => (
                      <li data-reveal>
                        <article class="library-row is-current">
                          <a class="library-media" href={book.reviewUrl} tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
                            {book.cover ? (
                              <img src={book.cover} alt="" width="120" height="180" />
                            ) : (
                              <span class="library-media-fallback"></span>
                            )}
                          </a>
                          <div>
                            <h3>
                              <a href={book.reviewUrl} target="_blank" rel="noopener noreferrer">
                                {book.title}
                              </a>
                            </h3>
                            {book.author && <p class="library-by">{book.author}</p>}
                            {book.rating ? <StarRating value={book.rating} /> : null}
                            {book.review && (
                              <a class="library-snippet" href={book.reviewUrl} target="_blank" rel="noopener noreferrer">
                                {book.review}
                              </a>
                            )}
                          </div>
                        </article>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }
            {
              reading.read.length > 0 && (
                <>
                  <h2 class="library-kicker">Read</h2>
                  <ul class="library-list">
                    {reading.read.map((book) => (
                      <li data-reveal>
                        <article class="library-row">
                          <a class="library-media" href={book.reviewUrl} tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
                            {book.cover ? (
                              <img src={book.cover} alt="" width="92" height="138" />
                            ) : (
                              <span class="library-media-fallback"></span>
                            )}
                          </a>
                          <div>
                            <h3>
                              <a href={book.reviewUrl} target="_blank" rel="noopener noreferrer">
                                {book.title}
                              </a>
                            </h3>
                            {book.author && <p class="library-by">{book.author}</p>}
                            {book.rating ? <StarRating value={book.rating} /> : null}
                            {book.review && (
                              <a class="library-snippet" href={book.reviewUrl} target="_blank" rel="noopener noreferrer">
                                {book.review}
                              </a>
                            )}
                          </div>
                        </article>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }
          </>
        )
      }
    </section>

    <section class="library-panel" id="panel-watching" data-panel="watching" role="tabpanel" aria-labelledby="tab-watching">
      <h2 class="library-panel-title">Watching</h2>
      {
        watching.films.length === 0 ? (
          <div class="library-empty">
            <h2>Nothing logged yet.</h2>
            <p>
              Recent films from <a href={watching.profileUrl}>Letterboxd</a> will show up here.
            </p>
          </div>
        ) : (
          <>
            <div class="library-section-head">
              <a href={watching.profileUrl} target="_blank" rel="noopener noreferrer">
                Letterboxd profile
              </a>
              {watching.fetchedAt && <time datetime={watching.fetchedAt}>Updated {updated(watching.fetchedAt)}</time>}
            </div>
            <h2 class="library-kicker">Recent films</h2>
            <ul class="library-list">
              {watching.films.map((film) => (
                <li data-reveal>
                  <article class="library-row is-film">
                    <a class="library-media" href={film.url} tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
                      {film.poster ? (
                        <img src={film.poster} alt="" width="92" height="138" />
                      ) : (
                        <span class="library-media-fallback"></span>
                      )}
                    </a>
                    <div>
                      <div class="library-title-line">
                        <h3>
                          <a href={film.url} target="_blank" rel="noopener noreferrer">
                            {film.title}
                          </a>
                        </h3>
                        {film.year ? <span class="library-year">{film.year}</span> : null}
                      </div>
                      {film.watchedDate && <p class="library-by">{watched(film.watchedDate)}</p>}
                      {film.rating ? <StarRating value={film.rating} /> : null}
                      {film.review && (
                        <a class="library-snippet" href={film.url} target="_blank" rel="noopener noreferrer">
                          {film.review}
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>

    <section class="library-panel" id="panel-youtube" data-panel="youtube" role="tabpanel" aria-labelledby="tab-youtube">
      <h2 class="library-panel-title">YouTube</h2>
      {
        videos.length === 0 ? (
          <div class="library-empty">
            <h2>No videos yet.</h2>
            {
              youtube.playlistUrl ? (
                <p>
                  <a href={youtube.playlistUrl} target="_blank" rel="noopener noreferrer">Open the playlist</a>. It does not have any videos yet.
                </p>
              ) : (
                <p>A YouTube playlist will show up here.</p>
              )
            }
          </div>
        ) : (
          <>
            <div class="library-section-head">
              {
                youtube.playlistUrl && (
                  <a href={youtube.playlistUrl} target="_blank" rel="noopener noreferrer">
                    YouTube playlist
                  </a>
                )
              }
              {youtube.fetchedAt && <time datetime={youtube.fetchedAt}>Updated {updated(youtube.fetchedAt)}</time>}
            </div>
            <h2 class="library-kicker">Playlist</h2>
            <ul class="library-list">
              {videos.map((video) => (
                <li data-reveal>
                  <article class="library-row is-video">
                    <a class="library-media" href={video.url} tabindex="-1" aria-hidden="true" target="_blank" rel="noopener noreferrer">
                      {video.thumbnail ? (
                        <img src={video.thumbnail} alt="" width="160" height="90" />
                      ) : (
                        <span class="library-media-fallback"></span>
                      )}
                    </a>
                    <div>
                      <h3>
                        <a href={video.url} target="_blank" rel="noopener noreferrer">
                          {video.title}
                        </a>
                      </h3>
                      {video.channel && <p class="library-by">{video.channel}</p>}
                      {video.addedAt && <p class="library-by">Added {added(video.addedAt)}</p>}
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
  </div>
</BaseLayout>
