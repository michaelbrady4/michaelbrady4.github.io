---
import type { Project } from '../projects';

interface Props {
  project: Project;
  heading?: 'h2' | 'h3';
}

const { project, heading: Heading = 'h2' } = Astro.props;
const liveLabel = `Live site for ${project.name} (opens in a new tab)`;
const codeLabel =
  project.visibility === 'public' ? `Code for ${project.name} (opens in a new tab)` : '';
---

<article class:list={['project-card', { 'is-private': project.visibility === 'private' }]}>
  <div class="project-card-head">
    <Heading>{project.name}</Heading>
    {
      project.visibility === 'private' && (
        <p class="project-private">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <rect
              x="3.25"
              y="7"
              width="9.5"
              height="6.25"
              rx="1.2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4" />
            <path
              d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round" />
          </svg>
          Private
        </p>
      )
    }
  </div>
  <p class="project-description">{project.description}</p>
  <p class="project-actions">
    <a
      class="project-visit"
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={liveLabel}
    >
      Live site
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          d="M4 12 12 4M6.5 4H12v5.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
    {
      project.visibility === 'public' && (
        <a
          class="project-code"
          href={project.code}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={codeLabel}
        >
          Code
        </a>
      )
    }
  </p>
</article>
