---
import { site } from '../site';
---

<div class="social">
  <ul class="social-list">
    <li>
      <a
        class="icon-control"
        href={site.links.x}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path>
        </svg>
      </a>
    </li>
    <li>
      <a
        class="icon-control"
        href={site.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
    </li>
    <li>
      <button
        type="button"
        class="icon-control copy-email"
        data-email={site.email}
        aria-label={`Copy email address ${site.email}`}
      >
        <span class="icon-swap" aria-hidden="true">
          <svg class="icon-mail" viewBox="0 0 24 24" focusable="false">
            <rect
              x="3.25"
              y="5.25"
              width="17.5"
              height="13.5"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"></rect>
            <path
              d="M4 7.2 12 13l8-5.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <svg class="icon-check" viewBox="0 0 24 24" focusable="false">
            <path
              d="M5 12.5 10 17.5 19 7.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>
    </li>
  </ul>
  <p class="copied-note" data-copied-note aria-hidden="true">Copied!</p>
  <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
</div>

<script>
  const RESET_MS = 2000;

  function fallbackCopy(text) {
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.top = '0';
    area.style.left = '0';
    area.style.width = '1px';
    area.style.height = '1px';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.focus();
    area.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(area);
    return ok;
  }

  async function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fall through to the legacy copy path.
      }
    }
    return fallbackCopy(text);
  }

  document.querySelectorAll('.copy-email').forEach((button) => {
    const email = button.getAttribute('data-email') || '';
    const social = button.closest('.social');
    const status = social ? social.querySelector('[data-copy-status]') : null;
    const defaultLabel = button.getAttribute('aria-label') || 'Copy email address';
    let timer = 0;

    button.addEventListener('click', async () => {
      window.clearTimeout(timer);
      const ok = await copyText(email);
      button.classList.toggle('is-copied', ok);
      if (social) social.classList.toggle('is-copied', ok);

      if (status) {
        status.textContent = '';
        window.setTimeout(() => {
          status.textContent = ok
            ? `Copied ${email} to the clipboard.`
            : 'Could not copy the email address.';
        }, 30);
      }

      timer = window.setTimeout(() => {
        button.classList.remove('is-copied');
        if (social) social.classList.remove('is-copied');
        button.setAttribute('aria-label', defaultLabel);
        if (status) status.textContent = '';
      }, RESET_MS);
    });
  });
</script>
